# Copy to .env and fill in. Never commit .env.

# --- Backend ---
# Skip Entra ID token validation and use a fixed dev user. Never enable in shared environments.
DEV_AUTH_BYPASS=true
# SQLite is fine for local dev; docker compose overrides this with PostgreSQL.
DATABASE_URL=sqlite:///./dbcompass.db
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# Microsoft Entra ID (used when DEV_AUTH_BYPASS=false)
ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=

# Azure AI Foundry (used from M5 onwards)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=dbcompass
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=dbcompass
