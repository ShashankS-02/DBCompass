# Copy to .env and fill in. Never commit .env.

# --- Backend ---
# Skip Entra ID token validation and use a fixed dev user. Never enable in shared environments.
DEV_AUTH_BYPASS=true
# SQLite is fine for local dev; docker compose overrides this with PostgreSQL.
DATABASE_URL=sqlite:///./dbcompass.db
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# Microsoft Entra ID (used when DEV_AUTH_BYPASS=false)
ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=

# Pricing (M4)
# GCP prices (Cloud Billing Catalog API). Use ONE of these; without either, GCP shows "price not available".
#   Service-account JSON key file (keep it outside the repo, e.g. ~/.config/dbcompass/gcp-billing.json):
GCP_SERVICE_ACCOUNT_FILE=
#   or a plain API key restricted to the Cloud Billing API:
GCP_BILLING_API_KEY=
# Rupees per US dollar for INR budgets and the USD/INR toggle, and the date of that rate.
INR_PER_USD=
INR_RATE_DATE=

# Azure AI Foundry (used from M5 onwards)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=dbcompass
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=dbcompass
