# Copy to .env.local for local `npm run dev`.

# Skip MSAL sign-in; the backend must also run with DEV_AUTH_BYPASS=true.
VITE_DEV_AUTH_BYPASS=true

# Backend address the dev server proxies /api to.
VITE_API_PROXY_TARGET=http://localhost:8000

# Microsoft Entra ID (used when VITE_DEV_AUTH_BYPASS=false)
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_SPA_CLIENT_ID=
# e.g. api://<api-client-id>/access_as_user
VITE_ENTRA_API_SCOPE=
